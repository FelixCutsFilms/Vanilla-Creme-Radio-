{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window (desktop)",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "core:window:allow-set-always-on-top",
    "core:tray:default",
    "opener:default"
  ],
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ]
}
