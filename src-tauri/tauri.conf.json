{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vanilla Creme Radio",
  "version": "0.1.0",
  "identifier": "com.felixh.radio",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Radio",
        "width": 400,
        "height": 580,
        "resizable": true,
        "minWidth": 320,
        "minHeight": 400,
        "minimizable": true,
        "maximizable": false
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["icons/tray-icon.png"],
    "macOS": {
      "infoPlist": "./Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
